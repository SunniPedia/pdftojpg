name: PDF to Image and Zip

on:
  push:
    paths:
      - 'pdf/*.pdf'
  workflow_dispatch:

jobs:
  convert:
    runs-on: ubuntu-latest
    outputs:
      matrix: ${{ steps.set-matrix.outputs.matrix }}
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: pip install pymupdf

      - name: Convert PDF to Images - short name
        shell: python
        run: |
          import pymupdf
          from pathlib import Path
          import math

          pdf_dir = Path("pdf")
          out_base = Path("images")
          out_base.mkdir(parents=True, exist_ok=True)

          BATCH = 200
          DPI = 300

          counter = 1  # pdf1, pdf2, pdf3...

          for pdf_file in sorted(pdf_dir.glob("*.pdf")):
              doc = pymupdf.open(pdf_file)
              total = len(doc)
              parts = math.ceil(total / BATCH)

              print(f"{pdf_file.name}: {total} pages -> {parts} pdf")

              for p in range(parts):
                  start = p * BATCH
                  end = min(start + BATCH, total)

                  new_doc = pymupdf.open()

                  for i in range(start, end):
                      page = doc[i]
                      pix = page.get_pixmap(dpi=DPI, alpha=False)
                      img_bytes = pix.tobytes("jpg", jpg_quality=95)
                      new_page = new_doc.new_page(width=page.rect.width, height=page.rect.height)
                      new_page.insert_image(new_page.rect, stream=img_bytes)

                  out_name = f"pdf{counter}.pdf"
                  out_path = out_base / out_name
                  new_doc.save(str(out_path), garbage=4, deflate=True)
                  new_doc.close()

                  print(f" -> Created {out_name} [ {pdf_file.stem} : {start+1} to {end} ]")
                  counter += 1

              doc.close()

      - name: Create matrix
        id: set-matrix
        run: |
          cd images || { echo 'matrix=[]' >> $GITHUB_OUTPUT; exit 0; }
          if ls *.pdf 1> /dev/null 2>&1; then
            MATRIX=$(ls *.pdf | jq -R -s -c 'split("\n") | map(select(length > 0))')
          else
            MATRIX="[]"
          fi
          echo "matrix=$MATRIX" >> $GITHUB_OUTPUT

      - name: Temp upload
        if: steps.set-matrix.outputs.matrix != '[]'
        uses: actions/upload-artifact@v4
        with:
          name: temp-pdfs
          path: images/*.pdf
          retention-days: 1

  upload-separate:
    needs: convert
    if: ${{ needs.convert.outputs.matrix != '[]' && needs.convert.outputs.matrix != '' }}
    runs-on: ubuntu-latest
    strategy:
      matrix:
        pdffile: ${{ fromJson(needs.convert.outputs.matrix) }}
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: temp-pdfs
          path: pdfs

      - name: Upload ${{ matrix.pdffile }}
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.pdffile }}
          path: pdfs/${{ matrix.pdffile }}
          retention-days: 7
